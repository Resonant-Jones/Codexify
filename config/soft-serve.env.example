# Copy to config/soft-serve.env on VaultNode and replace the placeholders.
# Keep this file outside shared secrets management; do not commit the copy.

# Required on first startup. Generate an Ed25519 public key for the operator,
# then replace this placeholder with the complete authorized_keys line.
SOFT_SERVE_INITIAL_ADMIN_KEYS=REPLACE_WITH_YOUR_ED25519_PUBLIC_KEY

# Empty uses the safe default below the operator's home directory.
CODEXIFY_SOFT_SERVE_DATA_DIR=

# Leave empty for loopback-only host publication. For remote operator access,
# set this to the VaultNode Tailscale IP, not 0.0.0.0.
CODEXIFY_SOFT_SERVE_BIND_HOST=

# Host-published ports. SSH is the required initial workflow; HTTP and stats
# are optional operator surfaces and remain loopback-only by default.
CODEXIFY_SOFT_SERVE_SSH_PORT=23231
CODEXIFY_SOFT_SERVE_HTTP_PORT=23232
CODEXIFY_SOFT_SERVE_STATS_PORT=23233

SOFT_SERVE_NAME=Codexify VaultNode Soft Serve

# Set these to the URLs operators should copy into clone instructions. Do not
# put credentials in URLs. Use a tailnet name or address only when configured.
SOFT_SERVE_SSH_PUBLIC_URL=ssh://REPLACE_WITH_FORGE_HOST:23231
SOFT_SERVE_HTTP_PUBLIC_URL=http://REPLACE_WITH_FORGE_HOST:23232
