{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qualification-registry.schema.json",
  "title": "Codexify Qualification Registry",
  "type": "object",
  "required": ["registry_version", "generated_from_repository", "qualifications"],
  "properties": {
    "registry_version": { "type": "integer", "const": 1 },
    "generated_from_repository": { "type": "boolean" },
    "release_authority": { "type": "string" },
    "qualifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "scope", "status", "freshness", "rubric", "metrics"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "scope": { "type": "string", "minLength": 1 },
          "status": { "enum": ["PASS", "HOLD", "FAIL"] },
          "freshness": { "enum": ["current", "stale", "superseded"] },
          "rubric": { "type": "string", "minLength": 1 },
          "latest_run": { "type": ["string", "null"] },
          "tested_commit": { "type": ["string", "null"] },
          "last_qualified_at": { "type": ["string", "null"] },
          "evidence": {
            "type": "array",
            "items": { "type": "string" }
          },
          "metrics": { "type": "object" },
          "blockers": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
