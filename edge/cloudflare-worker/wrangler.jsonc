{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "codexify-edge",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-04",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "persist": false
    }
  }
}
